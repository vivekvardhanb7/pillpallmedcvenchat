SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional overrides
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_ENCRYPTION_KEY=replace-with-a-long-random-local-secret

# Live testing only (scripts/smoke-live.mjs, test-customer-journeys.mjs --live,
# test-product-path-live.mjs). The secret must equal the "Value" of the Header
# Auth credential used by the Chat Turn Webhook node. Keep it out of the repo:
# export it in the shell instead, e.g.
#   PILLPAL_WEBHOOK_SECRET=... node scripts/smoke-live.mjs
PILLPAL_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/pillpal-chat-turn
PILLPAL_WEBHOOK_SECRET=YOUR_HEADER_AUTH_VALUE

# Local neural voice (Piper). Relative paths resolve from the project root.
# See README section 4 for the download links.
PIPER_BIN=tools/piper/piper.exe
PIPER_MODEL=tools/piper/voices/en_US-hfc_female-medium.onnx
# Optional per-language overrides (comma-separated code=path). Without this,
# English uses PIPER_MODEL and German looks for de_DE-kerstin-low.onnx.
# PIPER_MODELS=en=tools/piper/voices/en_US-hfc_female-medium.onnx,de=tools/piper/voices/de_DE-kerstin-low.onnx
# PIPER_LENGTH_SCALE=1.0
# PIPER_CACHE_DIR=tmp/tts-cache
# PIPER_TIMEOUT_MS=20000

# Spoken-answer understanding (optional, off by default). This maps a hard-to-parse
# spoken answer onto one of the option values already on screen. It never runs
# inside the n8n decision path and never sees the session state. Restart the
# kiosk server after changing it. See RUNBOOK section 6.
# PILLPAL_AI_PROVIDER=off            # off | ollama | gemini
# PILLPAL_AI_MIN_CONFIDENCE=0.6      # below this the kiosk asks again
# PILLPAL_AI_TIMEOUT_MS=10000        # CPU-only Ollama often needs 12000-15000
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:1.7b
# WHISPER_BIN=tools/whisper/Release/whisper-cli.exe
# WHISPER_MODEL=tools/whisper/models/ggml-base.bin
# WHISPER_TIMEOUT_MS=30000
# WHISPER_TRANSLATE=1                 # translate multilingual speech to English locally
# GEMINI_API_KEY=                    # stays on the kiosk; never sent to the browser
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Sulafat           # warm female exact-recitation voice
# GEMINI_MODEL=gemini-3.5-flash-lite # 2.5-flash-lite is closed to new API keys
# PILLPAL_AI_LOG_TRANSCRIPT=0        # 1 logs the raw transcript; keep off in a shop

# Optional Gemini Live Transcription. This replaces browser speech recognition
# with Gemini's real-time speech-to-text, using one short-lived token per turn.
# It sends microphone audio directly to Gemini; complete the privacy notice and
# obtain the customer's consent before enabling it in a real kiosk.
# GEMINI_LIVE_TRANSCRIBE=1
# GEMINI_CLOUD_ENABLED=0              # block Gemini TTS/translation in offline mode

# Hosted sidecar (n8n/build-understand-workflow.mjs). Gemini runs inside n8n
# instead of on the kiosk box, using a credential held by the instance - the key
# never appears in this file or in the browser. These ids are not secrets; copy
# them from n8n -> Credentials. The Header Auth credential id is the same one the
# Chat Turn Webhook uses, so the kiosk sends the secret it already has.
# N8N_BASE_URL=https://YOUR_N8N_HOST
# N8N_API_KEY=                       # n8n -> Settings -> n8n Users -> API
# N8N_WORKFLOW_ID=CtomsWyOIBEuYrtX                 # the safety workflow
# N8N_UNDERSTAND_WORKFLOW_ID=                      # the sidecar, once created
# N8N_GEMINI_CREDENTIAL_ID=                         # type googlePalmApi
# N8N_GEMINI_CREDENTIAL_NAME=

# Germany deployment. Browser language never changes this jurisdiction.
PILLPAL_COUNTRY_CODE=DE
PILLPAL_HOST=127.0.0.1
# Trusted Ed25519 public key for signed, dated clinical catalogue releases.
# PILLPAL_CATALOG_PUBLIC_KEY_FILE=config/catalog-public.pem

# Optional signed release path (reference JSON is used otherwise).
# PILLPAL_CATALOG_FILE=data/reviewed-germany-release.json

# PillPal Python/Flask RAG Service (services/rag/)
PILLPAL_RAG_HOST=127.0.0.1
PILLPAL_RAG_PORT=5001
PILLPAL_RAG_URL=http://127.0.0.1:5001
PILLPAL_RAG_TOKEN=pillpal-internal-rag-secret
PILLPAL_RAG_TIMEOUT_MS=2500
PILLPAL_RAG_MODE=offline            # offline (local vector index) | online (Pinecone)
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSION=384
# PINECONE_API_KEY=                 # required only if PILLPAL_RAG_MODE=online
# PINECONE_INDEX_NAME=medical-chatbot-staging
